{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "sourceMap": true,
        "strict": true,
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": [
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/types/**/*.d.ts",
        "src/routes/**/*.svelte",
        "src/routes/**/*.ts",
        "src/routes/**/*.js",
        "src/lib/**/*.svelte",
        "src/lib/**/*.ts",
        "src/lib/**/*.js",
        "src/components/**/*.svelte",
        "src/components/**/*.ts",
        "src/components/**/*.js"
    ],
    "exclude": ["node_modules"]
}
